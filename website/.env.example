# Register an OAuth application in GitLab with the read_user scope.
# The redirect URI must exactly match the registered application callback.
GITLAB_URL=https://gitlab.com
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_REDIRECT_URI=https://your-domain.example/auth/gitlab/callback

# Empty means any GitLab account can create its own private logbook.
# To restrict access, enter numeric GitLab user IDs separated by commas.
GITLAB_ALLOWED_USER_IDS=

# Set true when the public app is served over HTTPS.
SESSION_COOKIE_SECURE=true
